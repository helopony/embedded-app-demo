# Local defaults work with npm run dev and two distinct browser origins.
WORKSPACE_HOST_ORIGIN=http://localhost:3000
WORKSPACE_PARTNER_ORIGIN=http://127.0.0.1:3000
WORKSPACE_EXTRA_HOST_ORIGINS=
# Leave unset locally. Set host or partner on the respective deployed project.
# WORKSPACE_DEPLOYMENT_ROLE=
# Host only: signing key. Both projects: shared client secret. Use independently generated values of at least 32 bytes.
# DEMO_SIGNING_SECRET=
# DEMO_CLIENT_SECRET=
