{
  "name": "embedded-app-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test --workspace @workspace/bridge && node --import tsx --test lib/mock-auth/tokens.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@workspace/bridge": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "radix-ui": "^1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
